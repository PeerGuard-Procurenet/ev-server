# MongoDB
MONGODB_URI=mongodb://localhost:27017/evse?replicaSet=rs0

# Public gateway port (optional)
PORT=8080

# -----------------------------------------------------------------------------
# Paystack prepaid payments (Possible EVS customer journey)
# Create a business at https://dashboard.paystack.com
# Use Test keys until compliance activation; then switch to Live keys.
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
# Prefer the webhook signing secret (whsec_...) from Dashboard → Settings → API Keys & Webhooks.
# If unset, the secret key is used for HMAC-SHA512 verification of x-paystack-signature.
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxx
# Frontend URL Paystack redirects to after checkout (Payment success screen).
PAYSTACK_CALLBACK_URL=https://your-app.example/charging/payment-success
# Optional overrides when tenant simple pricing is not configured
PREPAID_ENERGY_RATE_PER_KWH=350
PREPAID_CURRENCY=NGN

# Webhook URL to configure in Paystack (test + live):
#   https://<your-host>/v1/util/prepaid/paystack/webhook?TenantID=<tenantObjectId>
# or with subdomain resolution used by CommonService.checkTenantValidity.
